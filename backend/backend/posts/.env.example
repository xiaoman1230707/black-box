# Runtime profile: pnpm start:dev / pnpm start:prod
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/black_box

# Generate a random value of at least 32 bytes; never reuse this placeholder.
TOKEN_SECRET=<generate-a-random-secret-of-at-least-32-bytes>

# Browser-facing origins. Production requires explicit non-local values.
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173

# false for direct access; loopback for a local in-process proxy; one-hop only
# when host port 3000 binds loopback and Nginx is the sole public entry.
TRUST_PROXY=false

# Chat provider.
DEEPSEEK_API_KEY=<deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Embedding provider (OpenAI-compatible endpoints are supported).
OPENAI_API_KEY=<openai-compatible-api-key>
OPENAI_BASE_URL=https://compatible-provider.example.invalid/v1
EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_TIMEOUT_MS=20000
AI_CHAT_TIMEOUT_MS=30000

# Optional rate-limit overrides. Values are positive integers; TTL is milliseconds.
THROTTLE_GLOBAL_LIMIT=60
THROTTLE_GLOBAL_TTL_MS=60000
THROTTLE_LOGIN_LIMIT=10
THROTTLE_LOGIN_TTL_MS=60000
THROTTLE_REGISTER_LIMIT=5
THROTTLE_REGISTER_TTL_MS=600000
THROTTLE_AI_CHAT_LIMIT=10
THROTTLE_AI_CHAT_TTL_MS=60000
THROTTLE_AI_SEARCH_LIMIT=30
THROTTLE_AI_SEARCH_TTL_MS=60000
THROTTLE_UPLOAD_LIMIT=20
THROTTLE_UPLOAD_TTL_MS=600000

# Demo seed profile only. Not required by runtime, cleanup, games or tag scripts.
DEMO_USER_PASSWORD=<local-demo-password>
