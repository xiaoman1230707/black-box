NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://black_box:replace-with-database-password@db:5432/black_box
TOKEN_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_BASE_URL=https://api.example.invalid
FRONTEND_ORIGIN=https://app.example.invalid
TRUST_PROXY=one-hop

DEEPSEEK_API_KEY=replace-with-provider-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=replace-with-compatible-provider-key
OPENAI_BASE_URL=https://compatible-provider.example.invalid/v1
EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_TIMEOUT_MS=20000
AI_CHAT_TIMEOUT_MS=30000

THROTTLE_GLOBAL_LIMIT=60
THROTTLE_GLOBAL_TTL_MS=60000
THROTTLE_LOGIN_LIMIT=10
THROTTLE_LOGIN_TTL_MS=60000
THROTTLE_REGISTER_LIMIT=5
THROTTLE_REGISTER_TTL_MS=600000
THROTTLE_AI_CHAT_LIMIT=10
THROTTLE_AI_CHAT_TTL_MS=60000
THROTTLE_AI_SEARCH_LIMIT=30
THROTTLE_AI_SEARCH_TTL_MS=60000
THROTTLE_UPLOAD_LIMIT=20
THROTTLE_UPLOAD_TTL_MS=600000
